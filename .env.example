# Copy to .env and supply unique local-only secrets. Never commit .env.
AUTH_DB_PASSWORD=
MOVIE_DB_PASSWORD=
CINEMA_DB_PASSWORD=
BOOKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Optional host-port overrides
AUTH_DB_PORT=54321
MOVIE_DB_PORT=54322
CINEMA_DB_PORT=54323
BOOKING_DB_PORT=54324
PAYMENT_DB_PORT=54325
NOTIFICATION_DB_PORT=54326
KAFKA_PORT=29092
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Optional AI service. Export these variables in the shell running Maven;
# Spring Boot does not automatically load this .env file.
AI_SERVICE_PORT=8087
AI_SERVICE_URL=http://localhost:8087
AI_CHAT_PROVIDER=none
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.2
