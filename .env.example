# Copy to .env and supply unique local-only secrets. Never commit .env.
AUTH_DB_PASSWORD=
MOVIE_DB_PASSWORD=
CINEMA_DB_PASSWORD=
BOOKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Optional host-port overrides
AUTH_DB_PORT=54321
MOVIE_DB_PORT=54322
CINEMA_DB_PORT=54323
BOOKING_DB_PORT=54324
PAYMENT_DB_PORT=54325
NOTIFICATION_DB_PORT=54326
KAFKA_PORT=29092
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# movie-service on Supabase (Session pooler, port 5432). Ask the project owner for the values.
DB_URL=jdbc:postgresql://<HOST>:5432/postgres
DB_USER=
DB_PASSWORD=

# auth-service on Supabase: own schema cinema_auth and own role auth_app.
# Username format for the pooler: <role>.<project-ref>
AUTH_DB_URL=jdbc:postgresql://<HOST>:5432/postgres?currentSchema=cinema_auth
AUTH_DB_USER=auth_app.<REF>
AUTH_DB_PASSWORD=
# Required: random string of at least 32 letters/digits. Auth does not start without it.
AUTH_JWT_SECRET=
# Shared with notification-service for the internal email lookup. Optional until then.
INTERNAL_API_TOKEN=
# Optional: keep the connection count low on the Supabase free plan.
spring.datasource.hikari.maximum-pool-size=3

# cinema-service on Supabase: own schema and own role cinema_app.
# Username format for the pooler: <role>.<project-ref>
# CINEMA_DB_PASSWORD is declared at the top of this file; set it there (do not repeat it here).
CINEMA_DB_URL=jdbc:postgresql://<HOST>:5432/postgres?currentSchema=cinema_cinema
CINEMA_DB_USER=cinema_app.<REF>
CINEMA_DB_PASSWORD=

# notification-service on Supabase: own schema and own role cinema_notification_app.
# Username format for the pooler: <role>.<project-ref>
# Local docker (default): jdbc:postgresql://localhost:54326/cinema_notification, user cinema_notification_app
NOTIFICATION_DB_URL=jdbc:postgresql://<HOST>:5432/postgres?currentSchema=cinema_notification
NOTIFICATION_DB_USER=cinema_notification_app.<REF>
NOTIFICATION_DB_PASSWORD=

# Optional AI service. Export these variables in the shell running Maven;
# Spring Boot does not automatically load this .env file.
AI_SERVICE_PORT=8087
AI_SERVICE_URL=http://localhost:8087
AI_CHAT_PROVIDER=none
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.2

#Bật xác thực 2 bước cho tài khoản Gmail dùng để gửi. Vào https://myaccount.google.com/security, mục "Xác minh 2 bước".
#Tạo App Password. Vào https://myaccount.google.com/apppasswords, đặt tên bất kỳ, Google sẽ cấp mã 16 ký tự.
OTP_MAIL_ENABLED=true
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

MAIL_MODE=smtp
MAIL_FROM=youremail@gmail.com