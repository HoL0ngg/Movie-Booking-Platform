// Simplified database design for a small Spring Boot + Kafka course project.
// Each namespace represents a SEPARATE service database.
// Cross-service IDs are logical references only; no cross-database foreign keys.
Project cinema_booking_platform_simplified {
  database_type: 'PostgreSQL'
  Note: 'Focus: Spring Boot, Kafka, seat-booking concurrency, and simple payment flow.'
}

// =========================
// AUTH SERVICE - 1 table
// =========================
Table auth.users {
  id uuid [pk]
  email text [not null, unique]
  password_hash text [not null]
  role varchar(20) [not null, note: 'Example: USER, ADMIN']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// =========================
// MOVIE SERVICE - 3 tables
// =========================
Table movie.movies {
  id uuid [pk]
  title text [not null]
  synopsis text
  duration_minutes int [not null]
  release_date date
  poster_url text
  status varchar(20) [not null, note: 'Example: COMING_SOON, SHOWING, ENDED']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (status, release_date)
  }
}


Table movie.genres {
  id uuid [pk]
  name varchar(80) [not null, unique]
  created_at timestamptz [not null]
}

Table movie.movie_genres {
  movie_id uuid [not null]
  genre_id uuid [not null]

  indexes {
    (movie_id, genre_id) [pk]
    genre_id
  }
}

Ref: movie.movie_genres.movie_id > movie.movies.id
Ref: movie.movie_genres.genre_id > movie.genres.id

// =========================
// CINEMA / SHOWTIME SERVICE - 5 tables
// Owns physical layout and showtime schedule, not live booking state.
// =========================
Table cinema.cinemas {
  id uuid [pk]
  name text [not null]
  address text [not null]
  created_at timestamptz [not null]
}

Table cinema.auditoriums {
  id uuid [pk]
  cinema_id uuid [not null]
  name text [not null]

  indexes {
    (cinema_id, name) [unique]
  }
}

Table cinema.seats {
  id uuid [pk]
  auditorium_id uuid [not null]
  row_label varchar(12) [not null]
  seat_number int [not null]
  seat_type varchar(20) [not null, note: 'Example: NORMAL, VIP']
  is_active boolean [not null]

  indexes {
    (auditorium_id, row_label, seat_number) [unique]
  }
}

Table cinema.showtimes {
  id uuid [pk]
  auditorium_id uuid [not null]
  movie_id uuid [not null, note: 'Logical Movie Service reference']
  starts_at timestamptz [not null]
  price_minor bigint [not null]
  status varchar(20) [not null, note: 'Example: OPEN, CLOSED, CANCELLED']
  created_at timestamptz [not null]

  indexes {
    (auditorium_id, starts_at)
    (movie_id, starts_at)
  }
}

// Transactional Outbox for reliable Kafka publishing.
// A simple polling publisher retries rows where published_at IS NULL.
Table cinema.outbox_events {
  event_id uuid [pk]
  event_type varchar(80) [not null]
  aggregate_id uuid [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]
  published_at timestamptz

  indexes {
    (published_at, created_at)
  }
}

Ref: cinema.auditoriums.cinema_id > cinema.cinemas.id
Ref: cinema.seats.auditorium_id > cinema.auditoriums.id
Ref: cinema.showtimes.auditorium_id > cinema.auditoriums.id

// =========================
// BOOKING SERVICE - 4 tables
// Owns live seat availability for each showtime.
// bookings also acts as the temporary reservation/hold object.
// =========================
Table booking.showtime_seats {
  id uuid [pk]
  showtime_id uuid [not null, note: 'Logical Cinema Service reference']
  seat_id uuid [not null, note: 'Logical Cinema Service reference']
  seat_label varchar(32) [not null]
  price_minor bigint [not null]
  status varchar(20) [not null, note: 'AVAILABLE, HELD, BOOKED']
  booking_id uuid
  hold_expires_at timestamptz
  updated_at timestamptz [not null]

  indexes {
    (showtime_id, seat_id) [unique]
    (showtime_id, status)
    hold_expires_at
  }
}

Table booking.bookings {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical Auth Service reference']
  showtime_id uuid [not null, note: 'Logical Cinema Service reference']
  total_amount_minor bigint [not null]
  status varchar(24) [not null, note: 'PENDING_PAYMENT, CONFIRMED, CANCELLED, EXPIRED']
  expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (user_id, created_at)
    (status, expires_at)
  }
}

Table booking.booking_items {
  id uuid [pk]
  booking_id uuid [not null]
  showtime_seat_id uuid [not null]
  price_minor bigint [not null]
  created_at timestamptz [not null]

  indexes {
    (booking_id, showtime_seat_id) [unique]
  }
}

// Used for PaymentRequested, BookingConfirmed, BookingExpired, etc.
Table booking.outbox_events {
  event_id uuid [pk]
  event_type varchar(80) [not null]
  aggregate_id uuid [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]
  published_at timestamptz

  indexes {
    (published_at, created_at)
  }
}

Ref: booking.showtime_seats.booking_id > booking.bookings.id
Ref: booking.booking_items.booking_id > booking.bookings.id
Ref: booking.booking_items.showtime_seat_id > booking.showtime_seats.id

// =========================
// PAYMENT SERVICE - 2 tables
// Payment is intentionally simplified for the course project.
// No payment attempts, provider webhook history, or refunds.
// =========================
Table payment.payments {
  id uuid [pk]
  booking_id uuid [not null, unique, note: 'Logical Booking Service reference; also makes PaymentRequested idempotent']
  amount_minor bigint [not null]
  payment_method varchar(30) [not null, note: 'Example: MOCK, VNPAY']
  status varchar(20) [not null, note: 'PENDING, SUCCESS, FAILED']
  transaction_ref varchar(160) [unique]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// Used to reliably publish PaymentSucceeded / PaymentFailed to Kafka.
Table payment.outbox_events {
  event_id uuid [pk]
  event_type varchar(80) [not null]
  aggregate_id uuid [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]
  published_at timestamptz

  indexes {
    (published_at, created_at)
  }
}

// =========================
// NOTIFICATION SERVICE - 1 table
// =========================
Table notification.notifications {
  id uuid [pk]
  source_event_id uuid [not null, note: 'Logical Kafka event reference']
  user_id uuid [not null, note: 'Logical Auth Service reference']
  channel varchar(16) [not null, note: 'Example: EMAIL']
  recipient_address text [not null]
  message text [not null]
  status varchar(16) [not null, note: 'PENDING, SENT, FAILED']
  created_at timestamptz [not null]
  sent_at timestamptz

  indexes {
    (source_event_id, channel) [unique]
  }
}
