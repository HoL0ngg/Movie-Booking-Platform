# Build the movie-service module from the repository root.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml ./pom.xml
COPY services/movie-service/pom.xml ./services/movie-service/pom.xml
COPY services/movie-service/src ./services/movie-service/src
RUN mvn -B -ntp -pl services/movie-service -am -Dmaven.test.skip=true package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/services/movie-service/target/*.jar /app/app.jar
ENV MOVIE_SERVICE_PORT=10000
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65.0 -XX:+UseSerialGC"
EXPOSE 10000
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
